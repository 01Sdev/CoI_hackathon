{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/outfit.ts": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/hud", "destination": "/index.html" },
    { "source": "/outward", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/wasm/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
